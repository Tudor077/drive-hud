<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    Android 11+ hides other installed apps unless they are declared here. Without
    this, the "Open Waze" button cannot tell whether Waze is installed.
  -->
  <queries>
    <package android:name="com.waze" />
    <package android:name="com.google.android.apps.maps" />
  </queries>

  <application>
    <service
      android:name="expo.modules.navlink.NavNotificationListenerService"
      android:label="Drive HUD navigation"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
